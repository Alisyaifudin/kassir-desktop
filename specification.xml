    <source root="src/">
      <dir name="services/">
        <description>
          The domain layer, and where nearly all application behaviour lives. Each service is a folder with
          index.ts (the Context.Tag interface and its types) and live.ts (the Layer). Hidden backends are db
          (SQLite, src/services/db/), store (plugin-store) and local-storage; every other folder is a public
          domain service re-exported on the app-level `service` object. See &lt;services&gt;.
        </description>
        <file name="index.ts">Composes the layers and exports `service`.</file>
      </dir>
      <dir name="pages/">
        <description>One folder per route, exporting a RouteObject.</description>
        <description>Migrated to the services layer: Login, Home, Product, Record, Money, Extra, Debt, Setting.</description>
        <description>Legacy, not routed, still importing the removed ~/database layer: Shop, Stock-PENDING, Analytics, Cashier, Customer, Method, Social, Setting/Sync_PENDING.</description>
      </dir>
      <dir name="components/">
        <description>Shared UI. Loader.tsx carries the data-flow hooks (useStream, useQuery, useMutation, Loader, LoaderMany); createErrorBoundary.tsx builds typed error boundaries; AdminOnly.tsx is the role guard.</description>
      </dir>
      <dir name="layouts/">root.tsx (size) and authenticated/ (topbar, nav, outlet).</dir>
      <dir name="hooks/">use-user, use-size, use-scroll, use-screen, use-submit, use-extra-search, use-product-search, use-image, use-get-url-back, use-generate-url-back.</dir>
      <dir name="lib/">auth, constants, date, effect-error, log, printer, random, reqwest, response, url, utils, validate, image, receipt/. Legacy survivors: result.ts, cache-factory.ts, sync/.</dir>
      <file name="route.tsx">Hash router definition; the only place routes are enabled or disabled.</file>
      <file name="main.tsx">React root; renders RouterProvider.</file>
    </source>
  </project_structure>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- PHASE 2: Backend (Tauri/Rust)                                        -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <rust_backend>
    <entry_point>
      <file name="src-tauri/src/main.rs">
        <description>Windows entry point with #[windows_subsystem = "windows"] in release mode (no console window). Calls kassir_lib::run().</description>
      </file>
      <file name="src-tauri/src/lib.rs">
        <description>Plugin registration, migration setup, and command handler registration.</description>
      </file>
      <file name="src-tauri/build.rs">
        <description>Standard tauri_build::build() for compile-time resource embedding.</description>
      </file>
    </entry_point>

    <commands>
      <command name="hash_password" module="auth">
        <signature>async fn(password: String) → Result&lt;String, AuthError&gt;</signature>
        <description>Hashes a plaintext password using bcrypt with DEFAULT_COST. Returns the hash string.</description>
        <error message="Hashing error: {bcrypt_error}" />
      </command>
      <command name="verify_password" module="auth">
        <signature>async fn(password: String, hash: String) → Result&lt;bool, AuthError&gt;</signature>
        <description>Verifies a plaintext password against a bcrypt hash. Returns true if matching.</description>
        <error message="Hashing error: {bcrypt_error}" />
      </command>
      <command name="encode_jwt" module="jwt">
        <signature>fn(name: String, role: String) → Result&lt;String, JwtError&gt;</signature>
        <description>Encodes a JWT (HS256) with UserClaims { name, role: Role, exp }. Expiry is 5 days from now. Secret key is hardcoded "super_secret_coy".</description>
        <error name="InvalidRole">Role string is not "user" or "admin".</error>
        <error name="InvalidToken">JWT encoding failed.</error>
      </command>
      <command name="decode_jwt" module="jwt">
        <signature>fn(token: String) → Result&lt;UserClaims, JwtError&gt;</signature>
        <description>Decodes and validates a JWT (HS256). Returns UserClaims { name, role, exp }.</description>
        <error name="InvalidToken">JWT decoding/validation failed.</error>
      </command>
      <command name="get_printers" module="printer">
        <signature>fn() → Result&lt;Vec&lt;PrinterInfo&gt;, String&gt;</signature>
        <description>Enumerates all Windows printer devices via winprint::PrinterDevice::all(). Returns list of { name, status: "Ready" }. Returns error if no printers found.</description>
      </command>
      <command name="print_pdf" module="printer">
        <signature>fn(printer_name: String, pdf_bytes: Vec&lt;u8&gt;) → Result&lt;String, String&gt;</signature>
        <description>Prints raw PDF bytes to a named Windows printer. Validates PDF header (%PDF). Saves bytes to a NamedTempFile, prints via WinPdfPrinter with default PrintTicket, then deletes temp file.</description>
        <error message="Invalid PDF: missing PDF header. First N bytes: {header}" />
        <error message="Printer '{name}' not found. Available printers: [{list}]" />
      </command>
    </commands>

    <jwt>
      <description>HS256 JWT with 5-day expiry. Claims: { name: String, role: Role (admin|user), exp: i64 }. Secret key: hardcoded "super_secret_coy". Role enum serializes as lowercase strings. gen_new_token refreshes token if within 2 days of expiry.</description>
    </jwt>

    <tauri_plugins>
      <plugin name="sql" version="2">
        <description>SQLite database with migration support. Preloads two databases: "sqlite:data.db" (41 migrations) and "sqlite:tx.db" (6 migrations).</description>
      </plugin>
      <plugin name="store" version="2">
        <description>Key-value persistent storage (used for sync token, app settings).</description>
      </plugin>
      <plugin name="http" version="2">
        <description>HTTP fetch client scoped to http://192.168.225.187:8787/** and https://api.kassir.store/*.</description>
      </plugin>
      <plugin name="fs" version="2">
        <description>Filesystem access restricted to $APPLOCALDATA/* and $APPLOCALDATA/logs/* (read and write).</description>
      </plugin>
      <plugin name="dialog" version="2">
        <description>Native file open/save dialogs.</description>
      </plugin>
      <plugin name="opener" version="2">
        <description>Opens URLs and files in the default system application.</description>
      </plugin>
      <plugin name="log" version="2">
        <description>Structured logging at Info level via Rust log crate.</description>
      </plugin>
      <plugin name="process" version="2">
        <description>Process management (restart, exit).</description>
      </plugin>
      <plugin name="updater" version="2">
        <description>Auto-updater with passive install mode on Windows. Checks for updates at https://github.com/Alisyaifudin/kassir-desktop/releases/latest/download/latest.json.</description>
      </plugin>
      <plugin name="prevent-default" version="4">
        <description>Prevents default browser behaviors in production. Allows: CONTEXT_MENU, RELOAD, FOCUS_MOVE, PRINT (all other defaults blocked).</description>
      </plugin>
    </tauri_plugins>

    <capabilities>
      <description>
        Mirrors `src-tauri/capabilities/*.json`, which `src/lib/tauri-capability.test.ts` guards: least
        privilege, no filesystem default, no updater, no process control. A permission nothing calls is a
        permission that must not be granted — `fs:default` and `updater:default` were removed for exactly that.
      </description>
      <capability name="default" windows="main">
        <permission>core:default</permission>
        <permission>core:window:allow-destroy → the close path: Tauri's Rust handler calls prevent_close() as soon as any JS listener sits on tauri://close-requested, so the window is only ever ended by a destroy() from useFlushOnExit (core:window:default does not include it — the app could not be quit while that was missing)</permission>
        <permission>sql:default, sql:allow-execute → the whole SQLite access layer (src/services/db)</permission>
        <permission>store:default, log:default</permission>
        <permission>fs:allow-mkdir → $APPDATA/images, $APPDATA/images/**</permission>
        <permission>fs:read-files → $APPDATA/images/**, $APPLOCALDATA/logs/**</permission>
        <permission>fs:write-files → $APPDATA/images/**, $APPLOCALDATA/logs/**</permission>
      </capability>
      <capability name="mcp-bridge" windows="main" dev-only="true">
        <permission>mcp-bridge:default → the debug-only automation bridge on 127.0.0.1:9223; enabled by src-tauri/tauri.dev.conf.json and never linked in a release build</permission>
      </capability>
    </capabilities>

    <migrations>
      <database name="data.db" migration_count="45">
        <description>
          45 SQL migrations managed by tauri-plugin-sql, applied on boot. The schema evolved from simple INTEGER
          primary keys to TEXT (ULID) keys with `_updated_at` / `_sync_at` bookkeeping for cloud sync. Key evolution:
          - Migrations 1-10: Initial tables (products, records, record_items), discount/credit/capital
          - Migrations 11-20: Barcode to TEXT, capital fixes, cashier with password, records redesign
          - Migrations 21-30: Price/capital to REAL, images, socials, money, payment methods
          - Migrations 31-40: TEXT (ULID) primary keys, product_events (event-sourced stock), sync columns; 39/41
            rename the money-kind concept to pocket*
          - Migration 41: add pocket_ordering
          - Migration 42: add extra_flag, and image/webp to the mime lookup
          - Migration 43: the decomposition — products split into listings/properties/images/stocks, records into
            record_listings/record_methods/record_extras/discounts, every top-level entity gains a soft-delete
            `&lt;singular&gt;_deleted_at`, and graves/graves_kind are retired
          - Migration 44: the tx (cart) tables
          - Migration 45: link product_events to records
        </description>
      </database>
      <database name="tx.db" migration_count="0">
        <description>
          Preloaded but unmanaged: tauri.conf.json still lists tx.db in plugins.sql.preload, yet no migrations ship
          for it any more and src/transaction/ is deleted. The tables it contains (transactions, products, discounts,
          extras — described under &lt;database&gt; / transaction_tx_db) are only referenced by the unrouted Shop page.
        </description>
      </database>
    </migrations>

    <embedded_api>
      <description>
        Embedded Axum HTTP server on 0.0.0.0:3000 (not started by default in the main lib.rs;
        the create_server function is defined in src/api/mod.rs but not called from run()).
        Uses sqlx with SQLite pool. Provides internal REST API for session and product management.
      </description>
      <endpoint method="GET" path="/">Returns "Backend is alive!"</endpoint>
      <endpoint method="GET" path="/check_health">Runs SELECT 1 against SQLite. Returns "OK" or "Database error".</endpoint>
      <endpoint method="POST" path="/api/session">
        <description>Authenticates with { name, password }. Queries cashiers table for user, verifies bcrypt hash. Returns JWT token on success, or { error: "Nama dan/atau kata sandi salah" } on failure.</description>
        <body>{ name: String, password: String }</body>
        <response success="{ token: String }" />
        <response error="{ error: String }" />
      </endpoint>
      <endpoint method="GET" path="/api/session">
        <description>Validates JWT from X-Header-Token header. Returns session { name, role } with refreshed token if needed. Returns null session if invalid/missing token.</description>
        <headers>X-Header-Token: &lt;jwt&gt;</headers>
        <response>{ token: String | null, session: { name: String, role: "admin"|"user" } | null }</response>
      </endpoint>
      <endpoint method="GET" path="/api/product">
        <description>Lists products updated after ?timestamp (default 0). Requires X-Header-Token auth. Returns { token, products: Product[] }.</description>
        <params>timestamp?: i64</params>
        <response>{ token: String, products: [{ id, name, price, stock, stock_back, barcode?, capital, note, updated_at }] }</response>
      </endpoint>
      <endpoint method="POST" path="/api/product">
        <description>Creates or updates a product. If id is provided, updates existing; otherwise inserts new. Checks barcode uniqueness (returns error if duplicate barcode). Requires X-Header-Token auth.</description>
        <body>{ id?: i64, name: String, price: f64, stock: i64, stock_back: i64, barcode?: String, capital: f64, note: String }</body>
        <response success="{ token: String }" />
        <response error="Barang sudah ada" />
      </endpoint>
      <token_refresh>
        <description>gen_new_token() refreshes the JWT if the current token expires within 2 days (now + 2*24*3600 > claims.exp). Otherwise returns the existing token unchanged.</description>
      </token_refresh>
    </embedded_api>
  </rust_backend>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- PHASE 3: Frontend Architecture                                       -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <frontend>
    <entry>
      <file name="src/main.tsx">
        <description>Creates ReactDOM root on #root element, renders RouterProvider with the hash router from src/route.tsx. No StrictMode wrapper. Imports global.css for Tailwind.</description>
      </file>
      <file name="index.html">
        <description>SPA entry. lang="id". &lt;body class="overflow-y-hidden"&gt; with &lt;div id="root" class="flex flex-col flex-1"&gt;. Loads /src/main.tsx as module.</description>
      </file>
    </entry>

    <routing>
      <description>
        Hash router (createHashRouter from react-router v7), defined in src/route.tsx. Routes are imported
        eagerly: the pages ship inside the binary, so a lazy chunk saves no download, and React's Suspense has
        no delay hook — it would flash a grey skeleton on every first visit. Only two boundaries stay dynamic:
        the receipt's pdf-lib (2.0 MB, `src/lib/receipt/index.ts`) and the chart surfaces (/analytics' five
        bodies and the product Performance tab — recharts + d3, ~420 kB). A page that has not been migrated yet
        stays imported-but-commented in route.tsx, so it is unreachable from the UI even though its folder is
        still on disk.
      </description>
      <route path="/" error_boundary="ErrorBoundary" layout="RootLayout">
        <route path="login" page="Login" auth="public" />
        <route path="/" guard="AuthLayout">
          <route index="true" page="Home" />
          <route path="products" page="Product">
            <route index="true" />
            <route path="new" page="ProductNew" guard="in-page admin" />
            <route path=":id" page="ProductDetail" />
          </route>
          <route path="records" page="Record">
