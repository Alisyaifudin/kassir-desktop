  </state_management>

  <sync_system status="not-wired">
    <description>
      Timestamp-based bidirectional sync. Each entity (product, product-event, record, method, grave) follows the
      same shape: pull → merge → push. A stored last-pull cursor fetches only deltas; pull gets count and data
      concurrently; merge compares the server's updatedAt with the local _updated_at to choose insert vs update;
      push uploads unsynced rows and marks them synced on the server's confirmation.
      The design below is still the intended protocol and the cloud endpoints exist, but the implementation is NOT
      wired: every file under src/lib/sync/ imports the removed ~/database, ~/store or ~/server modules and no longer
      compiles, src/pages/Setting/Sync_PENDING/ is neither routed nor in the settings nav, and nothing in the UI
      triggers a sync. Migration-43 also changed the contract these flows describe — deletion is now a soft
      `&lt;singular&gt;_deleted_at` column instead of the graves tombstone exchange, and products/records are nested
      payloads — so the flows must be reworked against the services before sync can run.
    </description>

    <sync_flow entity="product" order="1">
      <stage name="pull">GET /api/product/count/{ts} + GET /api/product/{ts} concurrently. Fetches all server products updated after last known timestamp.</stage>
      <stage name="merge">For each server product: if no local match → insert. If local updated_at &lt; server updatedAt → update. Tracks latest server updatedAt as new timestamp.</stage>
      <stage name="push">Gets unsynced local products. POST /api/product. On response, marks non-failed IDs as synced (concurrency: 50). Returns remaining unsync count.</stage>
      <stage name="store">Persists new last-pull timestamp via store.sync.product.set().</stage>
    </sync_flow>

    <sync_flow entity="product-event" order="1b">
      <description>Syncs product_events after products (FK dependency). Posts product IDs to get relevant events.</description>
      <stage name="pull">POST /api/product-event/{ts} with product IDs.</stage>
      <stage name="push">POST /api/product-event with unsynced events.</stage>
    </sync_flow>

    <sync_flow entity="record" order="2">
      <stage name="pull">GET /api/record/count/{ts} + GET /api/record/{ts}.</stage>
      <stage name="merge">Insert/update records with nested products, extras, discounts.</stage>
      <stage name="push">POST /api/record with unsynced records.</stage>
    </sync_flow>

    <sync_flow entity="method" order="3">
      <stage name="pull">GET /api/method/{ts}.</stage>
      <stage name="push">POST /api/method.</stage>
    </sync_flow>

    <sync_flow entity="grave" order="4" status="superseded">
      <description>
        Superseded by migration-43's SYNC CONTRACT: the graves / graves_kind tables are retired and deletion is a
        soft `&lt;singular&gt;_deleted_at` timestamp that syncs like any other update. The /api/grave endpoints and
        this tombstone exchange are dead and should be dropped when sync is rebuilt.
      </description>
      <stage name="pull">GET /api/grave/{ts}. Returns products[] and records[] tombstone IDs.</stage>
      <stage name="merge">Deletes local products and records matching tombstone IDs (db.product.del.sync, db.record.del.sync). Cleans up local grave entries for those IDs.</stage>
      <stage name="push">Collects local grave entries, DELETEs to /api/grave.</stage>
    </sync_flow>

    <error_handling>
      <case name="network">"Tidak bisa menghubungi server"</case>
      <case name="db">Logs error via log.error(), returns error message.</case>
      <case name="response">Uses responseError.failMsg() to extract server error.</case>
      <case name="validation">ZodSchemaError: logs validation issues, returns first 10 issue messages.</case>
    </error_handling>
  </sync_system>

