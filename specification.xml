  <!-- PHASE 5-8: API, State, Pages, Sync                                    -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <cloud_api>
    <description>
      Effect-TS based HTTP client (src/lib/reqwest.ts) wrapping @tauri-apps/plugin-http fetch.
      API base URL from VITE_API_URL env var (dev: http://192.168.225.187:8787, prod: https://api.kassir.store).
      All requests use Authorization: Bearer &lt;token&gt; header. Responses validated with Zod schemas.
      Error types: RequestError (network), ResponseError (non-2xx), BodyError (JSON parse), ZodSchemaError (validation).
      The per-entity clients (src/server/) and their Zod response schemas were removed with the services migration,
      so nothing calls these endpoints today — only src/lib/reqwest.ts survives. What follows is the contract the
      sync rebuild has to meet, and migration-43 changes part of it (soft-delete `_deleted_at` on server rows,
      nested product/record payloads, /api/grave retired, /api/method extended or replaced).
    </description>

    <entity name="product" base="/api/product">
      <endpoint method="GET" path="/api/product/{timestamp}">
        <description>Pull products updated after timestamp. Response: ProductServer[] ({ id, name, barcode?, price, stock, capital, note, updatedAt }).</description>
      </endpoint>
      <endpoint method="POST" path="/api/product">
        <description>Push local products. Body: Product[]. Response: { timestamp: number, failed: string[] }.</description>
      </endpoint>
      <endpoint method="GET" path="/api/product/count/{timestamp}">
        <description>Count server products. Response: { count: number }.</description>
      </endpoint>
    </entity>

    <entity name="product-event" base="/api/product-event">
      <endpoint method="POST" path="/api/product-event/{timestamp}">
        <description>Pull product events. Body: productIds[]. Response: ProductEventServer[] ({ id, createdAt, productId, type: manual|inc|dec, value }).</description>
      </endpoint>
      <endpoint method="POST" path="/api/product-event">
        <description>Push local product events. Response: { timestamp, failedIds }.</description>
      </endpoint>
    </entity>

    <entity name="record" base="/api/record">
      <endpoint method="GET" path="/api/record/{timestamp}">
        <description>Pull records updated after timestamp. Response: RecordServer[] with nested products (discounts), extras, customer.</description>
      </endpoint>
      <endpoint method="POST" path="/api/record">
        <description>Push local records. Response: { timestamp, failed: string[] }.</description>
      </endpoint>
      <endpoint method="GET" path="/api/record/count/{timestamp}">
        <description>Count server records. Response: { count: number }.</description>
      </endpoint>
    </entity>

    <entity name="method" base="/api/method">
      <endpoint method="GET" path="/api/method/{timestamp}">
        <description>Pull payment methods. Response: MethodServer[] ({ id, name?, kind: cash|transfer|debit|qris, deletedAt?, updatedAt? }).</description>
      </endpoint>
      <endpoint method="POST" path="/api/method">
        <description>Push local methods. Response: { timestamp, failed: string[] }.</description>
      </endpoint>
    </entity>

    <entity name="grave" base="/api/grave">
      <endpoint method="GET" path="/api/grave/{timestamp}">
        <description>Pull server deletion tombstones. Response: { products: string[], records: string[] }.</description>
      </endpoint>
      <endpoint method="DELETE" path="/api/grave">
        <description>Push local deletion tombstones. Body: { products: string[], records: string[] }. Response: { timestamp, records: string[], products: string[] }.</description>
      </endpoint>
    </entity>
  </cloud_api>

  <state_management>
    <description>
      Domain state belongs to the services (see &lt;services&gt;): each owns a SubscriptionRef, exposes reads as
      Effects and streams, and components subscribe rather than fetch. Two key-value backends sit underneath, reached
      only through the hidden `store` and `local-storage` services — never directly from a page:
      (1) @tauri-apps/plugin-store for store.json, the settings that should outlive the database, and
      (2) browser localStorage for the session and the UI size.
      @xstate/store survives only where a page is not migrated yet (the Analytics summary atoms) and in the
      shortcut-hint atom. The legacy src/store/ module tree is gone.
    </description>

    <persistent_store file="store.json">
      <entry key="name">Short shop name for the title bar (string, default "Toko"). Owned by the info service.</entry>
      <entry key="owner">Shop owner, also the receipt letterhead name (string, default "Toko"). Owned by info.</entry>
      <entry key="address">Shop address (string). Owned by info.</entry>
      <entry key="header">Receipt header text (string). Owned by info.</entry>
      <entry key="footer">Receipt footer text (string). Owned by info.</entry>
