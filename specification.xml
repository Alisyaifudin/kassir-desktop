  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- PHASE 4: Database Layer (Frontend SQLite via @tauri-apps/plugin-sql) -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <database>
    <connection>
      <description>
        data.db and tx.db are preloaded by @tauri-apps/plugin-sql (tauri.conf.json → plugins.sql.preload). The only
        frontend accessor is the hidden `db` service at src/services/db/ — domain services never touch plugin-sql
        themselves. DatabaseService exposes execute, selectMany, selectOne and transaction, each wrapped in Effect
        with a DbError. `transaction` joins its statements into one execute call, because plugin-sql has no
        transaction handle; a single execute is itself atomic, so a cross-table write is one multi-statement string.
        Raw SQL with parameterized queries; no ORM.
      </description>
      <file name="src/services/db/index.ts">Interface: execute, selectMany, selectOne, transaction, DbError.</file>
      <file name="src/services/db/live.ts">DatabaseLive — a lazily loaded Database handle behind Layer.succeed.</file>
      <type name="DbError">Data.TaggedError("DbError") with { message }. Each domain service maps it to its own error class at its boundary.</type>
    </connection>

    <schema>
      <description>
        The authoritative schema is the Rust migration set (src-tauri/src/database/&lt;range&gt;/migration-N.sql),
        applied by the sql plugin at boot — 45 migrations for data.db. The root-level schema.sql is a stale dev
        snapshot and is not applied. Since migration 43 the schema is decomposed: products split into
        listings / properties / images / stocks, records into record_listings / record_methods / record_extras /
        discounts, and deletion is a per-table soft `&lt;singular&gt;_deleted_at` column rather than the retired
        graves / graves_kind tables. `stocks` is a local cache rebuilt from `product_events`.
      </description>
    </schema>

    <ownership>
      <description>Which table — or which store/localStorage key — each service is the only writer of. The services themselves are described in the &lt;services&gt; section.</description>
      <owner service="cashier">cashiers</owner>
      <owner service="customer">customers</owner>
      <owner service="method">methods</owner>
      <owner service="extra">extras</owner>
      <owner service="social">socials</owner>
      <owner service="money">pockets, money</owner>
      <owner service="product">products, listings, properties, images, stocks, product_events</owner>
      <owner service="record">records, record_listings, discounts, record_extras, record_methods</owner>
      <owner service="config">localStorage key "size"</owner>
      <owner service="auth">localStorage key "user"</owner>
      <owner service="info">store keys: name, owner, address, header, footer, show-cashier</owner>
      <owner service="printer">store keys: printer_name, printer_width</owner>
      <owner service="log">$APPLOCALDATA/logs/kassir.log</owner>
    </ownership>

    <caching>
      <description>
        The cache-factory in-memory caches and their revalidate() calls went with the legacy layer. A service's
        SubscriptionRef is the cache: reads come from the ref once hydrated, and a write updates the database first
        and then the ref, so subscribers see it without being told. Pages that query rather than subscribe re-read on
        the owning service's `revision` stream. The one remaining explicit refresh is product.refresh(), because a
        record write moves stock behind the product aggregate's back.
      </description>
    </caching>

    <transaction_tx_db>
      <description>
        Separate tx.db database holding the tab-based POS cart. Not synced. It is currently dormant: tauri.conf.json
        still preloads it, but no Rust migrations ship for it any more and src/transaction/ has been deleted, so the
        only code that ever referenced these tables is the unrouted Shop page. The schema below is what the shipped
        tx.db file contains.
      </description>
      <table name="transactions">
        <column name="tab" type="INTEGER" primary_key="true" />
        <column name="tx_mode" type="TEXT" default="'sell'" />
        <column name="tx_query" type="TEXT" default="''" />
        <column name="tx_fix" type="INTEGER" default="0" />
        <column name="tx_method_id" type="INTEGER" default="1000" />
        <column name="tx_note" type="TEXT" default="''" />
        <column name="tx_customer_name" type="TEXT" default="''" />
        <column name="tx_customer_phone" type="TEXT" default="''" />
        <column name="tx_customer_id" type="INTEGER" nullable="true" />
        <column name="tx_product_barcode" type="TEXT" default="''" />
        <column name="tx_product_name" type="TEXT" default="''" />
        <column name="tx_product_price" type="REAL" default="0" />
        <column name="tx_product_qty" type="INTEGER" default="0" />
        <column name="tx_product_stock" type="INTEGER" default="0" />
        <column name="tx_extra_name" type="TEXT" default="''" />
        <column name="tx_extra_value" type="REAL" default="0" />
        <column name="tx_extra_kind" type="TEXT" default="'percent'" />
        <column name="tx_extra_is_saved" type="INTEGER" default="0" />
      </table>
      <table name="products">
        <column name="product_id" type="TEXT" primary_key="true" />
        <column name="tab" type="INTEGER" fk="transactions(tab) ON DELETE CASCADE" />
        <column name="db_product_id" type="TEXT" nullable="true" />
        <column name="db_product_price" type="REAL" nullable="true" />
        <column name="db_product_capital" type="REAL" nullable="true" />
        <column name="db_product_stock" type="INTEGER" nullable="true" />
        <column name="db_product_name" type="TEXT" nullable="true" />
        <column name="product_name" type="TEXT" />
        <column name="product_barcode" type="TEXT" />
        <column name="product_price" type="REAL" />
        <column name="product_qty" type="INTEGER" />
        <column name="product_created_at" type="INTEGER" />
      </table>
      <table name="discounts">
        <column name="disc_order" type="INTEGER" primary_key="true" />
        <column name="disc_id" type="TEXT" unique="true" />
        <column name="product_id" type="TEXT" fk="products(product_id) ON DELETE CASCADE" />
        <column name="disc_value" type="REAL" default="0" />
        <column name="disc_kind" type="TEXT" default="'percent'" />
      </table>
      <table name="extras">
        <column name="extra_id" type="TEXT" primary_key="true" />
        <column name="tab" type="INTEGER" fk="transactions(tab) ON DELETE CASCADE" />
        <column name="db_extra_id" type="INTEGER" nullable="true" />
        <column name="extra_kind" type="TEXT" />
        <column name="extra_name" type="TEXT" />
        <column name="extra_value" type="REAL" />
        <column name="extra_is_saved" type="INTEGER" />
      </table>
    </transaction_tx_db>

    <record_commit>
      <description>
        The record write path lives in the record service (src/services/record/live.ts) and builds one multi-statement
        transaction per write. record.add.external writes records + record_listings + discounts + record_extras +
        record_methods, responds to each line by moving stock (FIFO consumption for a sale, a cost lot for a
        purchase), then bumps the revision and calls product.refresh(). record.set.mode revisits the same stock rules
        when a record flips between sale and purchase, striking the old movement from the journal first.
      </description>
      <gap>
        There is no POS commit yet — no record.add.one taking the cart's inputs (listings, discounts, extras, split
        payments, customer) so the Shop page can commit a sale on the services layer. That method, and the migration
        of src/pages/Shop/, are the main remaining work before the POS can run again.
      </gap>
    </record_commit>
  </database>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- PHASE 4b: Effect Services (src/services/)                             -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <services>
    <description>
      Domain state lives in Effect services at src/services/&lt;name&gt;/ — index.ts is the interface only,
      live.ts is the Layer. Each service owns a SubscriptionRef as its single source of truth and exposes reads as
      Effects plus a changes Stream; a write goes to SQLite first and then the ref, so subscribers see it. Components
      subscribe with useStream / useQuery from src/components/Loader.tsx and render through Loader / LoaderMany, with
      typed errors caught by createErrorBoundary. src/services/index.ts composes the layers and exports the app-level
      `service` object (no provider needed at call sites). Unbounded, always-queried domains (records, entry lists)
      expose query Effects plus a `revision` counter instead of a full-list ref. Public services: config, auth,
      cashier, customer, extra, info, log, method, money, printer, product, record, social. Hidden backends: db,
      store, local-storage. The legacy ~/database, ~/store and ~/server modules are gone; a page either uses this
      layer or is not routed.
    </description>

    <hidden_backends>
      <description>Layered into every public service (Layer.provide) but not exposed on `service`.</description>
      <backend name="db" module="src/services/db/">execute / selectMany / selectOne / transaction over data.db; DbError. See &lt;database&gt;.</backend>
      <backend name="store" module="src/services/store/">plugin-store key-value: get / set / remove; StoreError, NotFound.</backend>
      <backend name="local-storage" module="src/services/local-storage/">localStorage key-value: get / set / remove; LocalStorageError, NotFound.</backend>
    </hidden_backends>

    <service name="config" module="src/services/config/">
      <description>The UI size preference. Owns the localStorage key "size".</description>
      <error name="ConfigError" tag="ConfigError" />
      <interface>
        <method name="size.get()">Current size: "big" | "small".</method>
        <method name="size.set(size)">Persist, then push to subscribers.</method>
        <method name="size.changes">Stream&lt;Size&gt;. RootLayout turns it into the body class; useSize() reads it.</method>
      </interface>
    </service>

    <service name="auth" module="src/services/auth/">
      <description>The signed-in session, persisted under the localStorage key "user".</description>
      <error name="AuthError" tag="AuthError" />
      <state>One SubscriptionRef holding User | null. Hydrating validates the stored id against the cashiers table; a session pointing at a deleted cashier is dropped and the key cleared.</state>
      <interface>
        <method name="get()">User | null.</method>
        <method name="set(user)">Persist (or clear) the session; null signs out.</method>
        <method name="changes">Stream&lt;User | null&gt;. Drives the AuthLayout guard, useUser() and the topbar.</method>
      </interface>
    </service>

    <service name="cashier" module="src/services/cashier/">
      <description>Login accounts. Local-only — cashiers are not synced.</description>
      <error name="CashierError" tag="CashierError" />
      <interface>
        <method name="get.all / get.byId(id) / get.changes">The roster, name-sorted. byId also returns the bcrypt hash and fails with NotFound.</method>
        <method name="add({id, name, role, hash})">Create an account; the caller hashes the password.</method>
        <method name="set.name / set.role / set.password">Rename, re-role, or replace the stored hash.</method>
        <method name="delete(id)">Remove the account.</method>
      </interface>
      <note>Hashing and verification live in lib/auth (Tauri bcrypt commands); the service stores whatever hash it is handed.</note>
    </service>

    <service name="customer" module="src/services/customer/">
      <description>Customer records (name, phone), read by the record pages.</description>
      <error name="CustomerError" tag="CustomerError" />
      <interface>
        <method name="get.all / get.unsync / get.changes" />
        <method name="add(name, phone) => id" />
        <method name="set.info(id, {name, phone}) / set.sync(id)" />
        <method name="delete.byId(id) / delete.sync(id)" />
      </interface>
    </service>

    <service name="method" module="src/services/method/">
      <description>Payment methods. Four built-in base rows (name null) plus named variants; kind is cash | transfer | debit | qris.</description>
      <error name="MethodError" tag="MethodError" />
      <interface><method name="get.all() / get.changes">The catalog, each kind's base row ahead of its named variants.</method></interface>
      <note>Read side only. The Method page that writes is not migrated.</note>
    </service>

    <service name="extra" module="src/services/extra/">
      <description>The surcharge/discount catalog. The DUAL_FLAG bit in `flag` marks an extra that books twice: a sale carrying it also commits an extras-only `outcoming` record for the same money (see services/record, records.record_pair_id). The flag is copied into the cart (`tx_extra_flag`) and the record (`record_extra_flag`), because a cart has no id link to the catalog. ValueKind (number | percent) lives in lib/constants and is shared with records.</description>
      <error name="ExtraError" tag="ExtraError" />
      <interface>
        <method name="get.all() / get.changes">Ordered by name in SQL.</method>
        <method name="add(input) => id">Insert at the end of the catalog.</method>
        <method name="set.info(id, input)" />
        <method name="delete.byId(id)">Soft-delete via extra_deleted_at.</method>
      </interface>
    </service>

    <service name="info" module="src/services/info/">
      <description>The shop identity used by receipts and the title bar: name, owner, address, header, footer, showCashier.</description>
      <error name="InfoError" tag="InfoError" />
      <interface>
        <method name="name() / info()" />
        <method name="set(info)">Writes all six store keys together, so a partial change reads first and patches (Setting/Shop/util-patch-info).</method>
        <method name="refresh()">Re-read after an external store writer changes the identity.</method>
        <method name="changes">Stream&lt;Info&gt;. Feeds the receipt, the title and the Setting shop form.</method>
      </interface>
    </service>

    <service name="log" module="src/services/log/">
      <description>The application log file, $APPLOCALDATA/logs/kassir.log.</description>
      <error name="LogError" tag="LogError" />
      <interface>
        <method name="lines.changes">Stream&lt;string[]&gt;, newest first with [WARN] lines filtered out. The file is the source of truth, so every subscription re-reads it.</method>
        <method name="clear()">Empty the file, then bump the revision so subscribers re-read.</method>
      </interface>
    </service>

    <service name="printer" module="src/services/printer/">
      <description>The receipt printer: the system printer name plus the paper width in mm. Owns the store keys printer_name and printer_width.</description>
      <error name="PrinterError" tag="PrinterError" />
      <interface><method name="get() / set(printer) / changes">Read by the Setting printer page and the receipt print path.</method></interface>
    </service>

    <service name="product" module="src/services/product/">
      <description>
        The product aggregate: a product with its listings (priced units, at most one code each), properties, images
        and stock lots. The read model's `stock` and `capital` are derived — sum of the lots, and their
        weighted-average cost. Owns products, listings, properties, images, stocks and product_events.
      </description>
      <error name="ProductError" tag="ProductError">Plus ProductDuplicateCode, carrying the code that was already taken.</error>
      <state>One SubscriptionRef of the whole read model; every write re-hydrates it, and get.changes / changesFull / unsync read from it.</state>
      <interface>
        <method name="get.all / get.byId / get.byCode / get.unsync / get.performance(id, range) / get.changes / get.changesFull" />
        <method name="add(input) => id">One transaction: the product, at least one listing, optional codes, and one stock lot.</method>
        <method name="set.info / set.listing.{add, update, remove} / set.property.{add, update, remove} / set.image.{add, remove, reorder}" />
        <method name="stock.{receive, consume, adjust, history}">FIFO consume and cost-lot receive; the pure SQL builders in product/stock-sql.ts are shared with the record service.</method>
        <method name="delete(id)">Soft-delete the product; children ride the aggregate.</method>
        <method name="refresh()">Re-hydrate after a record write moves stock — the one sanctioned revalidate.</method>
      </interface>
    </service>

    <service name="record" module="src/services/record/">
      <description>
        Committed transactions and everything snapshotted with them: listing lines with their discounts, extras, and
        split payments. Owns records, record_listings, discounts, record_extras and record_methods. The mode enum
        follows the money, not the goods: `incoming` is a sale (money in, stock consumed), `outcoming` a purchase
        (money out, stock received).
      </description>
      <error name="RecordError" tag="RecordError" />
      <state>
        Records are a queried domain (~64k rows, always read by range), so there is no full-list ref: the reads are
        Effects and get.revision is a counter bumped on every write, which a queried page puts in its query deps.
      </state>
      <interface>
        <method name="get.byRange(start, end, query?)">Records paid in [start, end), newest first, optionally narrowed by a listing-name match done in SQL.</method>
        <method name="get.byId(id)">The full record: lines, discounts, extras, methods.</method>
        <method name="get.listingHistory({start, end, mode, query, limit})">Capped page of matching lines plus the total match count.</method>
        <method name="get.debt()">Unsettled credit records, newest first. payCredit clears is_credit, so the flag is the outstanding marker.</method>
        <method name="get.revision">Write counter a queried page re-reads on.</method>
        <method name="count.summary(start, end)">Per-mode count and sum for a range.</method>
        <method name="add.external(input)">Import a record made elsewhere: lines + discounts + extras + methods in one transaction, moving stock by the same rules as a live record.</method>
        <method name="add.draft(input) => id">Commit a cart: header, lines, discounts, extras, payments, stock movement and the `tx_*` delete, in one transaction. When `input.mirror` is set it also writes the extras-only `outcoming` twin of the cart's DUAL_FLAG extras in that same commit, linking both rows through `record_pair_id`. A line that points at a catalogue listing is also the operator's latest word on the goods (record/sql/catalogue.ts): its edited name is written back to listings.listing_name — and to products.product_name when that product has a single live listing — while its price is written back only on a sale, and only in the unit the listing is priced in. Codes and units are never written back; the record keeps its own snapshot either way.</method>
        <method name="set.paidAt / set.note / set.mode / set.payment / set.toCredit / set.payCredit / set.linkListing" />
        <note>set.payment rewrites every record_methods row from the submitted list, so a method is re-filed, an amount restated, or a split added/trimmed in one save; record_pay is re-cached from the new sum and the totals never move. The sum must cover the grand total (underpaying is a credit, and set.toCredit records one), and an outstanding credit refuses it because its money arrives with set.payCredit.</note>
        <method name="delete.byId(id)">Soft-delete and reverse the stock movement the record caused. A paired record takes its twin with it, so voiding a sale never leaves the extras-only `outcoming` half behind.</method>
      </interface>
    </service>

    <service name="social" module="src/services/social/">
      <description>Receipt contact lines (name, value).</description>
      <error name="SocialError" tag="SocialError" />
      <interface><method name="get.all() / get.refresh() / get.changes" /></interface>
      <note>Read side only, because the receipt needs it. The Social page that writes is not migrated.</note>
    </service>


    <service name="money" module="src/services/money/">
      <description>
        Money pockets and their ledger, replacing the legacy ~/database money / money-kind modules. Owns the `pockets`
        and `money` tables in data.db (the table is `pockets` and every column `pocket_*` since migrations 39 and 41).
        Reads filter `*_deleted_at IS NULL`; deletes are soft (`pocket_deleted_at` / `money_deleted_at`), and deleting
        a pocket soft-deletes its entries too, since the FK cascade only fires on a physical delete.
      </description>
      <error name="MoneyError" tag="MoneyError">Wraps DbError at the service boundary.</error>
      <state>
        One SubscriptionRef holding PocketSummary[] — each pocket joined to its most recent entry — so a reorder, a
        rename and a new entry all reach subscribers through pockets.get.changes. A write folds the new entry into
        the owning pocket's card in memory; a delete re-reads it. Entry lists are queried, driven by
        entries.get.revision.
      </state>
      <interface>
        <group name="pockets">
          <read>
            <method name="get.summary()">The catalog, each pocket with its latest entry.</method>
            <method name="get.changes">Stream&lt;PocketSummary[]&gt; — catalog plus latest balances.</method>
          </read>
          <write>
            <method name="add({name,type})">Insert at the end of the ordering; returns the new id.</method>
            <method name="set.name(id,name)">Rename.</method>
            <method name="set.type(id,type)">Set the absolute | change type.</method>
            <method name="set.ordering([{id,order}])">Persist a drag reorder as one write.</method>
            <method name="delete.byId(id)">Soft-delete the pocket and every entry it holds.</method>
          </write>
        </group>
        <group name="entries">
          <read>
            <method name="get.byRange(pocketId,start,end)">Entries in [start,end), newest first.</method>
            <method name="get.all(pocketId)">Every entry, newest first — the JSON export.</method>
            <method name="get.last(pocketId,timestamp)">Balance before the range; 0 when nothing precedes it.</method>
            <method name="get.revision">Write counter a queried history re-reads on.</method>
          </read>
          <write>
            <method name="add.one({pocketId,timestamp,value,note})">Insert an absolute balance.</method>
            <method name="add.imported({pocketId,timestamp,value,note})">Insert unless the pocket already holds an entry at that instant; fails with DuplicateError(timestamp).</method>
            <method name="delete.byId(id)">Soft-delete one entry.</method>
          </write>
        </group>
      </interface>
    </service>
  </services>

