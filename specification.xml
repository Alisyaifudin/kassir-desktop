      <entry key="printer_name">Selected Windows printer (string). Owned by the printer service.</entry>
      <entry key="printer_width">Receipt paper width in mm (number, default 80). Owned by the printer service.</entry>
      <entry key="method-id">Selected payment method id (string). Legacy: read only by the unrouted Shop page.</entry>
      <entry key="token">Cloud sync token (string). Legacy: written by the unrouted Sync_PENDING form.</entry>
      <entry key="*-last-pull">Legacy sync cursors (product, record, method, grave, product-event). Read only by the stale src/lib/sync layers.</entry>
    </persistent_store>

