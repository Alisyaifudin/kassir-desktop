#!/bin/sh
#
# The last gate before code leaves the machine. Runs *every* gate the `Publish
# Windows App` workflow runs, in the same order and with the same flags — e2e
# included.
#
# e2e used to be excluded here, on the reasoning that the 20-run failure history
# had no e2e failures in it. 2026-11-10 falsified that: three pushes went out
# with a locally green "all 7 gates" report, and the run went red on a stale
# Playwright selector (`/Sinkronisasi berjalan manual/`, copy rewritten two
# commits earlier). Nothing in tsc, eslint, cargo or `bun test` can read a
# selector — only a browser driving the real app can. A gate that is not in this
# hook is a gate that only fails in CI, which is the entire reason the hook
# exists.
#
# It costs ~4 minutes instead of ~1. If that is too much for a WIP branch, push
# with `git push --no-verify` — and then do not call the result verified.

set -e

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-push: bun is not on PATH — skipping the CI mirror." >&2
  exit 0
fi

exec bun scripts/ci.ts --full
